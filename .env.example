# DNS A/AAAA record must point to this server before the first start.
SITE_DOMAIN=cover.example.com
ACME_EMAIL=admin@example.com

# Available variants: aurora, fjord, northline
SITE_VARIANT=aurora

# Local-only HTTPS port used as the REALITY target.
LOCAL_HTTPS_PORT=9443

# Optional safety check. Set this to the server's public IPv4 address and the
# preflight script will ensure SITE_DOMAIN resolves to it.
# SERVER_PUBLIC_IP=203.0.113.10
